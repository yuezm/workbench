{
  "extends": "./tsconfig.paths.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "vite.server.config.mts",
    "vite.web.config.mts",
    "playwright.config.ts",
    "tests/e2e/**/*",
    "tests/kernel/**/*",
    "tests/protocol/**/*",
    "tests/host/**/*",
    "tests/server/**/*",
    "tests/sdk/**/*",
    "tests/plugins/**/*",
    "tests/support/**/*",
    "tests/tools/**/*",
    "src/server/**/*",
    "packages/host/*/src/**/*",
    "packages/core/protocol/src/**/*",
    "packages/core/kernel/src/**/*",
    "packages/sdk/capabilities/src/**/*",
    "packages/contract/**/src/**/*",
    "packages/plugins/*/src/**/*",
    "packages/api/http/src/**/*",
    "packages/host/frontend-static/src/**/*",
    "packages/bundle/*/src/**/*",
    "apps/server/src/**/*"
  ]
}
