{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "vite.server.config.mts",
    "vite.web.config.mts",
    "playwright.config.ts",
    "tests/e2e/**/*",
    "tests/kernel/**/*",
    "tests/protocol/**/*",
    "tests/host/**/*",
    "tests/server/**/*",
    "tests/shared/**/*",
    "tests/sdk/**/*",
    "tests/plugins/**/*",
    "tests/support/**/*",
    "src/server/**/*",
    "src/host/**/*",
    "src/kernel/**/*",
    "src/protocol/**/*",
    "src/sdk/**/*",
    "src/plugins/**/*",
    "src/shared/**/*"
  ]
}
