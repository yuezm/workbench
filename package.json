{
  "name": "workbench",
  "version": "1.2.1",
  "private": true,
  "description": "个人工作台",
  "author": "Workbench",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "build:compile": "pnpm run typecheck && electron-vite build",
    "build": "pnpm run build:compile && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mutation:cron": "stryker run",
    "mutation:changed": "node scripts/mutation-scope.mjs",
    "mutation:scan": "node scripts/mutation-scope.mjs --scan",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:floor": "node scripts/floor-guard.mjs",
    "check:kernel": "node scripts/check-kernel-budget.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:ui": "node scripts/check-ui-rules.mjs",
    "check:diffcov": "node scripts/check-diff-coverage.mjs",
    "audit": "pnpm audit --prod --registry=https://registry.npmjs.org/ --audit-level=high",
    "check:fast": "pnpm run typecheck && pnpm run lint && pnpm run check:floor && pnpm run check:kernel && pnpm run check:secrets && pnpm run check:ui",
    "check": "pnpm run check:fast && pnpm run test:coverage && pnpm run check:diffcov && pnpm run audit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "pnpm run build:compile && playwright test",
    "e2e:packaged": "pnpm run build && playwright test -c playwright.packaged.config.ts",
    "e2e:redcheck": "node scripts/e2e-redcheck.mjs",
    "acceptance": "pnpm run check && pnpm run e2e",
    "acceptance:ui": "pnpm run build:compile && playwright test tests/e2e/ui-geometry.spec.ts",
    "acceptance:startup": "pnpm run build:compile && playwright test tests/e2e/startup.spec.ts",
    "db:export": "node scripts/export-db.mjs",
    "postinstall": "node node_modules/electron/install.js",
    "prepare": "husky"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.4.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
