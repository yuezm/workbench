{
  "name": "workbench",
  "version": "2.0.0",
  "private": true,
  "description": "个人工作台（常驻服务 + Web 界面）",
  "author": "Workbench",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build --config vite.server.config.mts && vite build --config vite.web.config.mts",
    "build:server": "vite build --config vite.server.config.mts",
    "build:web": "vite build --config vite.web.config.mts",
    "verify": "pnpm run verify:types && pnpm run verify:lint && pnpm run verify:guards && pnpm run verify:test",
    "verify:types": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "verify:lint": "eslint .",
    "verify:guards": "node scripts/floor-guard.mjs && node scripts/check-kernel-budget.mjs && node scripts/check-secrets.mjs && node scripts/check-ui-rules.mjs && node scripts/check-packages.mjs && node scripts/gen-workspace-paths.mjs --check && node scripts/check-mutation-scope.mjs",
    "verify:test": "vitest run",
    "verify:coverage": "vitest run --coverage && node scripts/check-diff-coverage.mjs",
    "verify:e2e": "pnpm run build && playwright test",
    "verify:mutation": "node scripts/mutation-scope.mjs",
    "verify:all": "pnpm run verify:types && pnpm run verify:lint && pnpm run verify:guards && pnpm run verify:coverage && pnpm audit --prod --registry=https://registry.npmjs.org/ --audit-level=high && pnpm run verify:e2e",
    "format": "prettier --write .",
    "gen:paths": "node scripts/gen-workspace-paths.mjs",
    "db:export": "node scripts/export-db.mjs",
    "start": "node out/server/index.js",
    "prepare": "husky",
    "git:clean": "node scripts/git/clean-gate.mjs",
    "git:mr": "node scripts/git/submit-mr.mjs --target main"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.4.0",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
